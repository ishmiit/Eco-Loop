!-   ===========================================================================
!-   Eco-Loop Building Agents Ã¢ÂÂ BASELINE BUILDING MODEL
!-   ===========================================================================
!-
!-   A three-zone FSSAI-licensed food business premises (Chennai, hot-humid):
!-
!-        +--------------+--------------+--------------+   N
!-        |   OFFICE     |  PROD_HALL   |  PACK_STORE  |   ^
!-        |   80 m2      |   80 m2      |   80 m2      |   |
!-        +--------------+--------------+--------------+
!-        x=0            8              16             24     (y: 0 -> 10 m)
!-
!-   * 240 m2 single storey, 3.6 m floor-to-roof, uninsulated RCC roof and
!-     230 mm brick walls Ã¢ÂÂ representative of Indian light-industrial stock.
!-   * Each zone is served by ZoneHVAC:IdealLoadsAirSystem so that the metric
!-     of merit is the *thermal load the control strategy creates*. Load is
!-     converted to electricity by an explicit plant model in Python
!-     (ecoloop.metrics.PlantModel: cooling COP 3.2, heating COP 3.0, fan
!-     1.0 kW per m3/s) applied identically to the baseline and the AI run.
!-   * Interior partitions are adiabatic Ã¢ÂÂ a standard simplification for a
!-     single-storey open plan with similar adjacent set-points.
!-
!-   THE CLOSED-LOOP CONTROL SURFACE
!-   Nine Schedule:Constant objects are the only things the agent writes to.
!-   They are actuated live through the EnergyPlus runtime API
!-   ("Schedule:Constant" / "Schedule Value"), so no IDF edit and no restart is
!-   needed to change control:
!-
!-       CSP_OFFICE  CSP_PROD  CSP_STORE   cooling set-point per zone   (C)
!-       HSP_OFFICE  HSP_PROD  HSP_STORE   heating set-point per zone   (C)
!-       OAF_OFFICE  OAF_PROD  OAF_STORE   outdoor-air fraction (0-1)
!-
!-   RunPeriod and Timestep are rewritten per run by ecoloop.sim.idf from the
!-   RunConfig; the values below are the committed defaults.
!-   ===========================================================================

  Version,
    25.2;

  SimulationControl,
    No,                     !- Do Zone Sizing Calculation
    No,                     !- Do System Sizing Calculation
    No,                     !- Do Plant Sizing Calculation
    No,                     !- Run Simulation for Sizing Periods
    Yes,                    !- Run Simulation for Weather File Run Periods
    No,                     !- Do HVAC Sizing Simulation for Sizing Periods
    1;                      !- Maximum Number of HVAC Sizing Simulation Passes

  Building,
    FoodPremises_3Zone,     !- Name
    0.0,                    !- North Axis {deg}
    City,                   !- Terrain
    0.04,                   !- Loads Convergence Tolerance Value {W}
    0.4,                    !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,           !- Solar Distribution
    25,                     !- Maximum Number of Warmup Days
    2;                      !- Minimum Number of Warmup Days

  Timestep,
    4;

  HeatBalanceAlgorithm,
    ConductionTransferFunction;

  SurfaceConvectionAlgorithm:Inside,
    TARP;

  SurfaceConvectionAlgorithm:Outside,
    DOE-2;

  Site:Location,
    Chennai_IND,            !- Name
    13.00,                  !- Latitude {deg}
    80.18,                  !- Longitude {deg}
    5.5,                    !- Time Zone {hr}
    16.0;                   !- Elevation {m}

  Site:GroundTemperature:BuildingSurface,
    26.0,
    26.0,
    27.0,
    28.0,
    29.0,
    29.5,
    29.0,
    28.5,
    28.0,
    27.5,
    27.0,
    26.5;

  RunPeriod,
    ClosedLoopWindow,       !- Name
    5,                      !- Begin Month
    12,                     !- Begin Day of Month
    ,                       !- Begin Year
    5,                      !- End Month
    14,                     !- End Day of Month
    ,                       !- End Year
    Tuesday,                !- Day of Week for Start Day
    No,                     !- Use Weather File Holidays and Special Days
    No,                     !- Use Weather File Daylight Saving Period
    No,                     !- Apply Weekend Holiday Rule
    Yes,                    !- Use Weather File Rain Indicators
    Yes;                    !- Use Weather File Snow Indicators

!-   --- CO2 / indoor air quality -------------------------------------------
  ZoneAirContaminantBalance,
    Yes,                    !- Carbon Dioxide Concentration
    OUTDOOR_CO2_SCH;        !- Outdoor Carbon Dioxide Schedule Name

!-   ===========================================================================
!-   SCHEDULE TYPE LIMITS
!-   ===========================================================================
  ScheduleTypeLimits,
    Fraction,
    0.0,
    1.0,
    CONTINUOUS;

  ScheduleTypeLimits,
    Temperature,
    -60,
    200,
    CONTINUOUS;

  ScheduleTypeLimits,
    ControlType,
    0,
    4,
    DISCRETE;

  ScheduleTypeLimits,
    Any Number;

  ScheduleTypeLimits,
    ActivityLevel,
    0,
    1000,
    CONTINUOUS;

  ScheduleTypeLimits,
    Velocity,
    0.0,
    3.0,
    CONTINUOUS;

  ScheduleTypeLimits,
    ClothingInsulation,
    0.0,
    2.0,
    CONTINUOUS;

  ScheduleTypeLimits,
    PPM,
    0,
    2000,
    CONTINUOUS;

!-   ===========================================================================
!-   THE AGENT'S CONTROL SURFACE Ã¢ÂÂ actuated at run time via the E+ API
!-   ===========================================================================
  Schedule:Constant,
    CSP_OFFICE,
    Temperature,
    24.0;

  Schedule:Constant,
    CSP_PROD,
    Temperature,
    24.0;

  Schedule:Constant,
    CSP_STORE,
    Temperature,
    24.0;

  Schedule:Constant,
    HSP_OFFICE,
    Temperature,
    21.0;

  Schedule:Constant,
    HSP_PROD,
    Temperature,
    21.0;

  Schedule:Constant,
    HSP_STORE,
    Temperature,
    21.0;

  Schedule:Constant,
    OAF_OFFICE,
    Fraction,
    1.0;

  Schedule:Constant,
    OAF_PROD,
    Fraction,
    1.0;

  Schedule:Constant,
    OAF_STORE,
    Fraction,
    1.0;

  Schedule:Constant,
    CONTROL_TYPE_DUAL,
    ControlType,
    4;

  Schedule:Constant,
    ALWAYS_ON,
    Fraction,
    1.0;

  Schedule:Constant,
    WORK_EFF_SCH,
    Fraction,
    0.0;

!-   Air movement per zone, produced by the CIRC_FAN_* equipment below. Ceiling
!-   fans in the office and packing areas (0.40 m/s) and industrial circulators
!-   in the production hall (0.80 m/s) are near-universal in Indian food units,
!-   and they are what makes elevated air set-points comfortable at all: BEE and
!-   ECBC guidance pairs a 24-26 C set-point with air movement for exactly this
!-   reason. Their electricity and motor heat are modelled, so the comfort
!-   benefit is not free.
  Schedule:Constant,
    AIR_VELO_OFFICE,
    Velocity,
    0.40;

  Schedule:Constant,
    AIR_VELO_PROD,
    Velocity,
    0.80;

  Schedule:Constant,
    AIR_VELO_STORE,
    Velocity,
    0.40;

  Schedule:Constant,
    CLOTHING_SCH,
    ClothingInsulation,
    0.5;

  Schedule:Constant,
    OUTDOOR_CO2_SCH,
    PPM,
    420.0;

  Schedule:Constant,
    INFIL_SCH,
    Fraction,
    1.0;

!-   ===========================================================================
!-   OPERATING SCHEDULES Ã¢ÂÂ a two-shift food unit
!-   Production 06:00-18:00 Mon-Sat, office 09:00-18:00 Mon-Fri.
!-   ===========================================================================
  Schedule:Compact,
    OCC_OFFICE_SCH,         !- Name
    Fraction,               !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 09:00,
    0.0,
    Until: 13:00,
    0.95,
    Until: 14:00,
    0.5,
    Until: 18:00,
    0.9,
    Until: 19:00,
    0.25,
    Until: 24:00,
    0.0,
    For: Saturday,
    Until: 09:00,
    0.0,
    Until: 14:00,
    0.4,
    Until: 24:00,
    0.0,
    For: AllOtherDays,
    Until: 24:00,
    0.0;

  Schedule:Compact,
    OCC_PROD_SCH,           !- Name
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 06:00,
    0.0,
    Until: 10:00,
    1.0,
    Until: 13:00,
    0.9,
    Until: 14:00,
    0.4,
    Until: 18:00,
    0.95,
    Until: 19:00,
    0.3,
    Until: 24:00,
    0.0,
    For: Saturday,
    Until: 06:00,
    0.0,
    Until: 14:00,
    0.7,
    Until: 24:00,
    0.0,
    For: AllOtherDays,
    Until: 24:00,
    0.0;

  Schedule:Compact,
    OCC_STORE_SCH,          !- Name
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 07:00,
    0.0,
    Until: 12:00,
    0.6,
    Until: 14:00,
    0.3,
    Until: 18:00,
    0.7,
    Until: 24:00,
    0.0,
    For: Saturday,
    Until: 08:00,
    0.0,
    Until: 14:00,
    0.4,
    Until: 24:00,
    0.0,
    For: AllOtherDays,
    Until: 24:00,
    0.0;

  Schedule:Compact,
    LIGHT_SCH,              !- Name
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 06:00,
    0.05,
    Until: 19:00,
    0.9,
    Until: 21:00,
    0.2,
    Until: 24:00,
    0.05,
    For: Saturday,
    Until: 06:00,
    0.05,
    Until: 15:00,
    0.7,
    Until: 24:00,
    0.05,
    For: AllOtherDays,
    Until: 24:00,
    0.05;

  Schedule:Compact,
    EQUIP_SCH,              !- Name
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 06:00,
    0.15,
    Until: 18:00,
    0.85,
    Until: 20:00,
    0.35,
    Until: 24:00,
    0.15,
    For: Saturday,
    Until: 06:00,
    0.15,
    Until: 14:00,
    0.6,
    Until: 24:00,
    0.15,
    For: AllOtherDays,
    Until: 24:00,
    0.15;

!-   Metabolic rate per person: 120 W office (1.0 met), 200 W production
!-   (1.7 met, standing light work), 165 W packing.
  Schedule:Constant,
    ACTIVITY_OFFICE_SCH,
    ActivityLevel,
    120.0;

  Schedule:Constant,
    ACTIVITY_PROD_SCH,
    ActivityLevel,
    200.0;

  Schedule:Constant,
    ACTIVITY_STORE_SCH,
    ActivityLevel,
    165.0;

!-   ===========================================================================
!-   CONSTRUCTIONS
!-   ===========================================================================
  Material,
    PLASTER_12MM,           !- Name
    MediumRough,            !- Roughness
    0.012,                  !- Thickness {m}
    0.720,                  !- Conductivity {W/m-K}
    1860.0,                 !- Density {kg/m3}
    840.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.60,                   !- Solar Absorptance
    0.60;                   !- Visible Absorptance

  Material,
    BRICK_230MM,            !- Name
    MediumRough,            !- Roughness
    0.230,                  !- Thickness {m}
    0.810,                  !- Conductivity {W/m-K}
    1820.0,                 !- Density {kg/m3}
    880.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.70,                   !- Solar Absorptance
    0.70;                   !- Visible Absorptance

  Material,
    BRICK_115MM,            !- Name
    MediumRough,            !- Roughness
    0.115,                  !- Thickness {m}
    0.810,                  !- Conductivity {W/m-K}
    1820.0,                 !- Density {kg/m3}
    880.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.70,                   !- Solar Absorptance
    0.70;                   !- Visible Absorptance

  Material,
    RCC_150MM,              !- Name
    MediumRough,            !- Roughness
    0.150,                  !- Thickness {m}
    1.730,                  !- Conductivity {W/m-K}
    2400.0,                 !- Density {kg/m3}
    880.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.75,                   !- Solar Absorptance
    0.75;                   !- Visible Absorptance

  Material,
    ROOF_SCREED_40MM,       !- Name
    Rough,                  !- Roughness
    0.040,                  !- Thickness {m}
    1.100,                  !- Conductivity {W/m-K}
    2000.0,                 !- Density {kg/m3}
    900.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.3,                    !- Solar Absorptance
    0.3;                    !- Visible Absorptance

!-   Optional layer used only by the roof-insulation ECM the agent may write.
  Material,
    ROOF_INSUL_50MM,        !- Name
    Smooth,                 !- Roughness
    0.050,                  !- Thickness {m}
    0.035,                  !- Conductivity {W/m-K}
    32.0,                   !- Density {kg/m3}
    1210.0,                 !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.60,                   !- Solar Absorptance
    0.60;                   !- Visible Absorptance

  Material,
    CONCRETE_SLAB_200MM,    !- Name
    MediumRough,            !- Roughness
    0.200,                  !- Thickness {m}
    1.730,                  !- Conductivity {W/m-K}
    2400.0,                 !- Density {kg/m3}
    880.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.65,                   !- Solar Absorptance
    0.65;                   !- Visible Absorptance

  Material,
    FLOOR_TILE_10MM,        !- Name
    Smooth,                 !- Roughness
    0.010,                  !- Thickness {m}
    1.300,                  !- Conductivity {W/m-K}
    2300.0,                 !- Density {kg/m3}
    840.0,                  !- Specific Heat {J/kg-K}
    0.90,                   !- Thermal Absorptance
    0.55,                   !- Solar Absorptance
    0.55;                   !- Visible Absorptance

  WindowMaterial:SimpleGlazingSystem,
    GLAZING_SINGLE_CLEAR,   !- Name
    5.80,                   !- U-Factor {W/m2-K}
    0.82,                   !- Solar Heat Gain Coefficient
    0.88;                   !- Visible Transmittance

!-   Optional glazing used only by the glazing-upgrade ECM.
  WindowMaterial:SimpleGlazingSystem,
    GLAZING_DGU_LOWE,       !- Name
    1.80,                   !- U-Factor {W/m2-K}
    0.28,                   !- Solar Heat Gain Coefficient
    0.62;                   !- Visible Transmittance

  Construction,
    EXT_WALL,               !- Name
    PLASTER_12MM,           !- Outside Layer
    BRICK_230MM,            !- Layer 2
    PLASTER_12MM;           !- Layer 3

  Construction,
    INT_PARTITION,          !- Name
    PLASTER_12MM,           !- Outside Layer
    BRICK_115MM,            !- Layer 2
    PLASTER_12MM;           !- Layer 3

  Construction,
    ROOF_UNINSULATED,       !- Name
    ROOF_SCREED_40MM,       !- Outside Layer
    RCC_150MM,              !- Layer 2
    PLASTER_12MM;           !- Layer 3

  Construction,
    GROUND_FLOOR,           !- Name
    CONCRETE_SLAB_200MM,    !- Outside Layer
    FLOOR_TILE_10MM;        !- Layer 2

  Construction,
    WINDOW_CLEAR,           !- Name
    GLAZING_DGU_LOWE;       !- Outside Layer

!-   ===========================================================================
!-   ZONES
!-   ===========================================================================
  GlobalGeometryRules,
    UpperLeftCorner,        !- Starting Vertex Position
    CounterClockWise,       !- Vertex Entry Direction
    World,                  !- Coordinate System
    ,                       !- Daylighting Reference Point Coordinate System
    World;                  !- Rectangular Surface Coordinate System

  Zone,
    OFFICE,                 !- Name
    0.0,                    !- Direction of Relative North {deg}
    0.0,
    0.0,
    0.0,                    !- X,Y,Z Origin {m}
    1,                      !- Type
    1,                      !- Multiplier
    3.6,                    !- Ceiling Height {m}
    288.0,                  !- Volume {m3}
    80.0;                   !- Floor Area {m2}

  Zone,
    PROD_HALL,              !- Name
    0.0,                    !- Direction of Relative North {deg}
    0.0,
    0.0,
    0.0,                    !- X,Y,Z Origin {m}
    1,                      !- Type
    1,                      !- Multiplier
    3.6,                    !- Ceiling Height {m}
    288.0,                  !- Volume {m3}
    80.0;                   !- Floor Area {m2}

  Zone,
    PACK_STORE,             !- Name
    0.0,                    !- Direction of Relative North {deg}
    0.0,
    0.0,
    0.0,                    !- X,Y,Z Origin {m}
    1,                      !- Type
    1,                      !- Multiplier
    3.6,                    !- Ceiling Height {m}
    288.0,                  !- Volume {m3}
    80.0;                   !- Floor Area {m2}

