!-   ===========================================================================
!-   HVAC Ã¢ÂÂ ideal loads per zone, dual set-point thermostats on the
!-   agent-actuated schedules, ventilation scaled by the OAF_* schedules.
!-   ===========================================================================
  DesignSpecification:OutdoorAir,
    DSOA_OFFICE,            !- Name
    Sum,                    !- Outdoor Air Method
    0.0025,                 !- Outdoor Air Flow per Person {m3/s-person}
    0.0003,                 !- Outdoor Air Flow per Zone Floor Area {m3/s-m2}
    ,                       !- Outdoor Air Flow per Zone {m3/s}
    ,                       !- Outdoor Air Flow Air Changes per Hour {1/hr}
    OAF_OFFICE;             !- Outdoor Air Schedule Name

!-   The production hall is ventilated above the ASHRAE 62.1 minimum, as FSSAI
!-   hygiene practice requires for a food-handling space. That also leaves the
!-   agent real headroom for demand-controlled ventilation: at full flow the
!-   hall settles near 800 ppm, so cutting outdoor air is a genuine lever
!-   rather than an instant CO2 breach.
  DesignSpecification:OutdoorAir,
    DSOA_PROD,              !- Name
    Sum,                    !- Outdoor Air Method
    0.0045,                 !- Outdoor Air Flow per Person {m3/s-person}
    0.0010,                 !- Outdoor Air Flow per Zone Floor Area {m3/s-m2}
    ,                       !- Outdoor Air Flow per Zone {m3/s}
    ,                       !- Outdoor Air Flow Air Changes per Hour {1/hr}
    OAF_PROD;               !- Outdoor Air Schedule Name

  DesignSpecification:OutdoorAir,
    DSOA_STORE,             !- Name
    Sum,                    !- Outdoor Air Method
    0.0025,                 !- Outdoor Air Flow per Person {m3/s-person}
    0.0004,                 !- Outdoor Air Flow per Zone Floor Area {m3/s-m2}
    ,                       !- Outdoor Air Flow per Zone {m3/s}
    ,                       !- Outdoor Air Flow Air Changes per Hour {1/hr}
    OAF_STORE;              !- Outdoor Air Schedule Name

