    90,                     !- Tilt Angle {deg}
    8.0,
    10.0,
    0.0,                    !- Starting X,Y,Z {m}
    8.0,                    !- Length {m}
    3.6;                    !- Height {m}

  Window,
    OFFICE_WIN_N,           !- Name
    WINDOW_CLEAR,           !- Construction Name
    OFFICE_WALL_N,          !- Building Surface Name
    ,                       !- Frame and Divider Name
    1,                      !- Multiplier
