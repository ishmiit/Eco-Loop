!-   ===========================================================================
!-   OUTPUT Ã¢ÂÂ the Python layer reads sensors through the API, so this section
!-   only produces the human-readable evidence artifacts (eplustbl.htm).
!-   ===========================================================================
  Output:VariableDictionary,
    IDF;

  OutputControl:Table:Style,
    HTML,
    JtoKWH;

  Output:Table:SummaryReports,
    AnnualBuildingUtilityPerformanceSummary,
    ClimaticDataSummary,
    EnvelopeSummary,
    SensibleHeatGainSummary;

  Output:Meter,
    Electricity:Facility,
    Hourly;

  Output:Variable,
    *,
    Zone Mean Air Temperature,
    Hourly;

  Output:Variable,
    *,
    Zone Air CO2 Concentration,
    Hourly;

  Output:Variable,
    *,
    Zone Ideal Loads Supply Air Total Cooling Rate,
    Hourly;
