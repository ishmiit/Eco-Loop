  Wall:Exterior,
    STORE_WALL_S,           !- Name
    EXT_WALL,               !- Construction Name
    PACK_STORE,             !- Zone Name
    ,                       !- Space Name
    180,                    !- Azimuth Angle {deg}
    90,                     !- Tilt Angle {deg}
