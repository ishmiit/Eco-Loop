    ,                       !- Space Name
    270,                    !- Azimuth Angle {deg}
    90,                     !- Tilt Angle {deg}
    0.0,
    10.0,
    0.0,                    !- Starting X,Y,Z {m}
    10.0,                   !- Length {m}
    3.6;                    !- Height {m}

  Roof,
    OFFICE_ROOF,            !- Name
    ROOF_UNINSULATED,       !- Construction Name
    OFFICE,                 !- Zone Name
    ,                       !- Space Name
    180,                    !- Azimuth Angle {deg}
    0,                      !- Tilt Angle {deg}
    0.0,
    0.0,
    3.6,                    !- Starting X,Y,Z {m}
    8.0,                    !- Length {m}
    10.0;                   !- Width {m}

  Floor:GroundContact,
    OFFICE_FLOOR,           !- Name
    GROUND_FLOOR,           !- Construction Name
    OFFICE,                 !- Zone Name
    ,                       !- Space Name
    90,                     !- Azimuth Angle {deg}
    180,                    !- Tilt Angle {deg}
    0.0,
    0.0,
    0.0,                    !- Starting X,Y,Z {m}
    8.0,                    !- Length {m}
    10.0;                   !- Width {m}

